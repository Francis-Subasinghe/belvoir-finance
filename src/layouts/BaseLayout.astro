---
import "../styles/global.css";
import { CSP_DIRECTIVES, NOT_ADVICE_PLACEHOLDER, PREVIEW, SITE_NAME, SITE_TAGLINE, cspString } from "../config/site";
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
  /** Per-page noindex, e.g. for demo content (CONTENT_MODEL `demo: true`). */
  noindex?: boolean;
}
const { title, description = SITE_TAGLINE, noindex = false } = Astro.props;
const robots = PREVIEW || noindex ? "noindex, nofollow" : "index, follow";
const pageTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
// The CSP is emitted in production builds only; Astro's dev server injects
// inline scripts and styles that a strict policy would block.
const csp = import.meta.env.PROD ? cspString(CSP_DIRECTIVES) : null;
const nav = [
  { href: withBase("/"), label: "Home" },
  { href: withBase("/stories/"), label: "Stories" },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    {csp && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <header class="site-header surface-navy">
      <div class="container">
        <a class="brand" href={withBase("/")}>
          {SITE_NAME}
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <aside class="notice" aria-label="Not financial advice" data-testid="not-advice-notice">
      <div class="container">
        <slot name="notice">
          <p>{NOT_ADVICE_PLACEHOLDER}</p>
        </slot>
      </div>
    </aside>
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer surface-slate">
      <div class="container">
        <p>
          <span class="brand-accent">{SITE_NAME}</span> — {SITE_TAGLINE}
        </p>
        <p>{NOT_ADVICE_PLACEHOLDER}</p>
        {PREVIEW && <p>Preview build. Not indexed by search engines.</p>}
      </div>
    </footer>
  </body>
</html>
