---
import "../styles/global.css";
import {
  CSP_DIRECTIVES,
  FOOTER_NAV,
  MAIN_NAV,
  NOT_ADVICE_PLACEHOLDER,
  PREVIEW,
  SITE_NAME,
  SITE_TAGLINE,
  cspString,
} from "../config/site";
import { withBase } from "../lib/paths";
import SiteNav, { type NavItem } from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import DemoBanner from "../components/DemoBanner.astro";

interface Props {
  title: string;
  description?: string;
  /** Per-page noindex, e.g. for demo content (CONTENT_MODEL `demo: true`). */
  noindex?: boolean;
  /**
   * True when the page's content entry has `demo: true` (F3-33, F3-47). Shows
   * the demo banner, forces `noindex, nofollow` even with PUBLIC_PREVIEW=false,
   * and emits the belvoir-demo marker (Lighthouse skips SEO on it).
   */
  demo?: boolean;
  /**
   * True for a page in PLACEHOLDER_PAGES (Q-10): demo banner and
   * `noindex, nofollow`, but no belvoir-demo marker. Lighthouse exempts these
   * from SEO by exact path instead.
   */
  placeholder?: boolean;
  /** Override the main nav (used only by the dev-only D12 wireframes). */
  nav?: NavItem[];
}
const { title, description = SITE_TAGLINE, noindex = false, demo = false, placeholder = false } = Astro.props;
const robots = PREVIEW || noindex || demo || placeholder ? "noindex, nofollow" : "index, follow";
const pageTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
// The CSP is emitted in production builds only; Astro's dev server injects
// inline scripts and styles that a strict policy would block.
const csp = import.meta.env.PROD ? cspString(CSP_DIRECTIVES) : null;
// F3-03: Home, Explore, Tools and Sources; the footer has the other sitemap pages.
const nav: NavItem[] = Astro.props.nav ?? MAIN_NAV.map((n) => ({ href: withBase(n.path), label: n.label }));
const footer: NavItem[] = FOOTER_NAV.map((n) => ({ href: withBase(n.path), label: n.label }));
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    {csp && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Base-aware, self-hosted icon (img-src 'self'), so browsers never request /favicon.ico at the root. -->
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <meta name="robots" content={robots} />
    {demo && <meta name="belvoir-demo" content="true" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <header class="site-header surface-navy">
      <div class="container">
        <a class="brand" href={withBase("/")}>
          {SITE_NAME}
        </a>
        <SiteNav items={nav} current={Astro.url.pathname} />
      </div>
    </header>
    <aside class="notice" aria-label="Not financial advice" data-testid="not-advice-notice">
      <div class="container">
        <slot name="notice">
          <p>{NOT_ADVICE_PLACEHOLDER}</p>
        </slot>
      </div>
    </aside>
    <main id="main" class="container" tabindex="-1">
      {(demo || placeholder) && <DemoBanner />}
      <slot />
    </main>
    <SiteFooter links={footer} />
  </body>
</html>
