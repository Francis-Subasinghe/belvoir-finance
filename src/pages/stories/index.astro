---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StoryCard from "../../components/StoryCard.astro";
import { cardProps, publishedStories } from "../../lib/site-content";
import { withBase } from "../../lib/paths";

// F3-07 (Q-5): every published story, newest first (ties by id). Not a redirect.
const stories = await publishedStories();
---

<BaseLayout title="All stories" description="Every published Belvoir Finance story, newest first.">
  <h1>All stories</h1>
  <p class="page-intro prose">
    Every published story, newest first. <a href={withBase("/explore/")}>Explore by topic</a>.
  </p>
  <ul class="story-list">
    {stories.map((s) => (
      <li>
        <StoryCard {...cardProps(s)} headingLevel={2} />
      </li>
    ))}
  </ul>
</BaseLayout>
