---
import BaseLayout from "../layouts/BaseLayout.astro";
import StoryCard from "../components/StoryCard.astro";
import { getCollection } from "astro:content";
import { SITE_NAME, SITE_TAGLINE } from "../config/site";
import { featuredStory } from "../lib/stories";
import { cardProps, publishedStories, tool, toolHref, topicHref, topics } from "../lib/site-content";
import { withBase } from "../lib/paths";
import HeroArt from "../components/art/HeroArt.astro";
import PillarArt from "../components/art/PillarArt.astro";
import Icon from "../components/art/Icon.astro";
import ToolIcon from "../components/art/ToolIcon.astro";

// F3-06: promise, featured story (Q-6), topic paths, featured tool, newsletter CTA.
const featured = featuredStory(await publishedStories());
const allTopics = await topics();
const featuredToolId = allTopics.find((t) => t.data.featuredTool)?.data.featuredTool;
const featuredTool = featuredToolId ? await tool(featuredToolId) : undefined;
const cta = (await getCollection("newsletterCtas")).sort((a, b) => (a.id < b.id ? -1 : 1))[0];
---

<BaseLayout
  title={SITE_NAME}
  description="Belvoir Finance explains business finance for UK founders and operators, one clear idea at a time."
>
  <div class="page-hero home-hero">
    <div class="page-hero-text">
      <p class="eyebrow">Education-first publication</p>
      <h1>{SITE_TAGLINE}</h1>
      <p class="page-intro prose">
        Belvoir Finance explains business finance for UK founders and operators. Belvoir Finance is the publisher. The
        stories here are demo content while the publication is being built.
      </p>
    </div>
    <HeroArt />
  </div>

  {featured && (
    <section class="page-section" aria-labelledby="featured-heading" data-testid="featured-story">
      <h2 id="featured-heading">Featured story</h2>
      <StoryCard {...cardProps(featured)} headingLevel={3} />
    </section>
  )}

  <section class="page-section" aria-labelledby="topics-heading">
    <h2 id="topics-heading">Topic paths</h2>
    <ul class="story-list">
      {allTopics.map((t) => (
        <li>
          <article class="story-card surface-white" data-testid="topic-card">
            <PillarArt pillar={t.data.pillar} size="card" />
            <h3 class="story-card-title with-icon">
              <Icon name={t.data.pillar} />
              <a href={topicHref(t.id)}>{t.data.title}</a>
            </h3>
            <p class="story-card-summary">{t.data.summary}</p>
            {t.data.demo && <p class="story-card-demo">Demo content</p>}
          </article>
        </li>
      ))}
    </ul>
  </section>

  {featuredTool && (
    <section class="feature-band surface-navy" aria-labelledby="tool-heading" data-testid="featured-tool">
      <p class="eyebrow with-icon">
        <ToolIcon id={featuredTool.id} />
        Featured tool
      </p>
      <h2 id="tool-heading">{featuredTool.data.title}</h2>
      <p>{featuredTool.data.summary}</p>
      <p>
        <a href={toolHref(featuredTool.id)}>Try the {featuredTool.data.title.toLowerCase()}</a>
      </p>
    </section>
  )}

  {cta && (
    <section class="page-section" aria-labelledby="newsletter-heading" data-testid="newsletter-cta">
      <h2 id="newsletter-heading">{cta.data.heading}</h2>
      <p>{cta.data.valueProp}</p>
      <p>Cadence: {cta.data.cadence}</p>
      <p class="page-links">
        <a href={withBase("/newsletter/")}>About the newsletter</a>
      </p>
    </section>
  )}
</BaseLayout>
