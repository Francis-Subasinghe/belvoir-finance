---
/**
 * V1-01 home hero illustration. Decorative, never animated (V1-29, V2-24), V2
 * line art on a surface-raised panel in a 24 px frame; the curve is gold-on-light
 * (V2-28). Width and height
 * attributes plus the viewBox reserve its box (V1-35).
 */
import Hero from "../../assets/hero.svg";
---

<div class="art-panel art-panel-hero surface-raised" data-testid="hero-art">
  <Hero class="art-svg" aria-hidden="true" focusable="false" />
</div>
