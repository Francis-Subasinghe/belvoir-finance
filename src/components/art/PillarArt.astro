---
/**
 * V1-41: the illustration for a pillar (one per pillar, Q-1). Decorative
 * (aria-hidden, focusable=false, no title); imported as an Astro SVG component
 * (V1-56), coloured by token classes on a navy panel (V1-14, V1-15).
 */
import UnderstandTheNumbers from "../../assets/pillars/understand-the-numbers.svg";
import MakeBetterDecisions from "../../assets/pillars/make-better-decisions.svg";
import FinanceInContext from "../../assets/pillars/finance-in-context.svg";
import BuildCapability from "../../assets/pillars/build-capability.svg";
import type { PILLARS } from "../../content/schemas";

interface Props {
  pillar: (typeof PILLARS)[number];
  size?: "card" | "page";
}
const ART = {
  "understand-the-numbers": UnderstandTheNumbers,
  "make-better-decisions": MakeBetterDecisions,
  "finance-in-context": FinanceInContext,
  "build-capability": BuildCapability,
} as const;
const { pillar, size = "page" } = Astro.props;
const Art = ART[pillar];
---

<div class={`art-panel art-panel-${size} surface-navy`} data-testid="pillar-art" data-pillar={pillar}>
  <Art class="art-svg" aria-hidden="true" focusable="false" />
</div>
