---
/**
 * F2-26 chart wrapper: a <figure> with a caption (title, units, source) and a
 * data table as the text equivalent. The SVG is decorative (aria-hidden)
 * because the table carries the data. Series are told apart by direct value
 * labels and a legend with distinct marker shapes (solid vs outlined), not
 * colour alone; colours come from tokens via classes. No inline styles, no
 * chart library and no remote resources.
 *
 * V1: the Markdoc `chart` tag renders through this same component
 * (markdoc/Chart.astro is a thin adapter), with `note` set to "Illustrative
 * demo data". Bars carry `chart-bar` for the draw-in (V1-31); values and the
 * table are static text from the first frame. Labels are plain Astro
 * expressions, so they are always escaped (V1-55). The SVG has width and
 * height attributes so its box is reserved before CSS loads (V1-11).
 */
interface Series {
  name: string;
  values: number[];
}
interface Props {
  title: string;
  units: string;
  source: string;
  categories: string[];
  series: [Series, Series] | [Series];
  /** Extra caption line, e.g. "Illustrative demo data" (V1-44). */
  note?: string | undefined;
}
const { title, units, source, categories, series, note } = Astro.props;
const nf = new Intl.NumberFormat("en-GB");
const max = Math.max(1, ...series.flatMap((s) => s.values));
const W = 320;
const H = 180;
const bottom = 24;
const groupW = W / categories.length;
const barW = Math.min(36, (groupW - 12) / series.length);
/*
 * F4-51: labels are positioned so the widest a label can render stays inside
 * the viewBox. The CSS caps label size at 13 units; hinted mono advances reach
 * about 0.66 em at small on-screen sizes, so 0.7 em per character is the
 * worst case. A label near either edge moves inward just enough; the rest
 * stay centred on their bar or category.
 *
 * V2 (Firefox 360 px overlap of "9,100" and "11,600"): collision handling is
 * done here in viewBox units against the same worst case, so it doesn't depend
 * on any engine's text metrics. Two value labels in one category whose
 * worst-case boxes overlap horizontally are kept at least LABEL_GAP apart
 * vertically (the higher one moves up), and the plot top grows if a moved
 * label would leave the viewBox.
 */
const LABEL_MAX_UNITS = 13;
const LABEL_ADVANCE_EM = 0.7;
const LABEL_GAP = 20; // > 1.5 em at 13 units: line box plus clearance in any engine
const LABEL_TOP_MIN = 15; // baseline needs ~1.15 em of room above it
const labelX = (centre: number, text: string): number => {
  const half = (text.length * LABEL_ADVANCE_EM * LABEL_MAX_UNITS) / 2;
  const x = Math.min(W - half, Math.max(half, centre));
  return Math.round(x * 100) / 100;
};
const halfW = (text: string) => (text.length * LABEL_ADVANCE_EM * LABEL_MAX_UNITS) / 2;
const layout = (top: number) => {
  const plotH = H - top - bottom;
  const bars = categories.flatMap((cat, ci) =>
    series.map((s, si) => {
      const v = s.values[ci] ?? 0;
      const h = (v / max) * plotH;
      const x = ci * groupW + (groupW - barW * series.length) / 2 + si * barW;
      const label = nf.format(v);
      return {
        key: `${cat}-${si}`,
        x,
        y: top + plotH - h,
        h,
        v,
        si,
        label,
        lx: labelX(x + barW / 2, label),
        ly: top + plotH - h - 4,
      };
    }),
  );
  for (let ci = 0; ci < categories.length; ci++) {
    const [a, b] = bars.slice(ci * series.length, ci * series.length + series.length);
    if (!a || !b) continue;
    const xOverlap = Math.abs(a.lx - b.lx) < halfW(a.label) + halfW(b.label);
    if (xOverlap && Math.abs(a.ly - b.ly) < LABEL_GAP) {
      const [hi, lo] = a.ly <= b.ly ? [a, b] : [b, a];
      hi.ly = lo.ly - LABEL_GAP;
    }
  }
  return { plotH, bars };
};
let top = 22;
let { plotH, bars } = layout(top);
const highest = Math.min(...bars.map((b) => b.ly));
if (highest < LABEL_TOP_MIN) {
  top += LABEL_TOP_MIN - highest;
  ({ plotH, bars } = layout(top));
}
---

<figure class="chart surface-white" data-testid="chart">
  <figcaption class="chart-caption">
    <span class="chart-title">{title}</span>
    <span class="chart-units">Units: {units}</span>
    <span class="chart-source">Source: {source}</span>
    {note && <span class="chart-note">{note}</span>}
  </figcaption>
  <ul class="chart-legend" aria-hidden="true">
    {series.map((s, si) => (
      <li>
        <svg class="chart-marker" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false">
          <rect class={si === 0 ? "chart-series-1" : "chart-series-2-outline"} x="1" y="1" width="10" height="10" />
        </svg>
        {s.name}
      </li>
    ))}
  </ul>
  <svg class="chart-svg" viewBox={`0 0 ${W} ${H}`} width={W} height={H} aria-hidden="true" focusable="false">
    <line class="chart-axis" x1="0" y1={top + plotH} x2={W} y2={top + plotH} />
    {bars.map((b) => (
      <g>
        <rect
          class={`chart-bar ${b.si === 0 ? "chart-series-1" : "chart-series-2-outline"}`}
          x={b.x + 1}
          y={b.y}
          width={barW - 2}
          height={b.h}
        />
        <text
          class="chart-value numeric"
          data-numeric="true"
          x={b.lx}
          y={Math.round(b.ly * 100) / 100}
          text-anchor="middle"
        >
          {b.label}
        </text>
      </g>
    ))}
    {categories.map((c, ci) => (
      <text
        class="chart-category numeric"
        data-numeric="true"
        x={labelX(ci * groupW + groupW / 2, c)}
        y={H - 6}
        text-anchor="middle"
      >
        {c}
      </text>
    ))}
  </svg>
  <div class="table-scroll" tabindex="0" role="region" aria-label={`Data table: ${title}`}>
    <table class="data-table">
      <caption class="visually-hidden">
        {title}({units})
      </caption>
      <thead>
        <tr>
          <th scope="col">Category</th>
          {series.map((s) => (
            <th scope="col" class="data-table-num">
              {s.name}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {categories.map((c, ci) => (
          <tr>
            <th scope="row">{c}</th>
            {series.map((s) => (
              <td class="numeric data-table-num" data-numeric="true">
                {nf.format(s.values[ci] ?? 0)}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>
