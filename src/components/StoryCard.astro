---
/**
 * F2-22 story card. The heading level is a prop so lists keep a valid
 * outline. The title link is the card's only interactive element. Format,
 * level, a non-UK jurisdiction (F3-22) and demo status are always text,
 * never colour alone.
 * Surfaces: white (default), alabaster, slate.
 * V1-42: every card shows the story's derived cover (decorative, first in the
 * card visually, outside the heading and link so reading and tab order keep F3's).
 */
import { formatDateGB, isoDate, jurisdictionLabel, labelOf } from "../lib/format";
import StoryCover from "./art/StoryCover.astro";

interface Props {
  title: string;
  href: string;
  /** Story id and first pillar: the cover's only inputs (V1-42). */
  coverId: string;
  pillar: string;
  summary: string;
  format: string;
  level: string;
  date?: Date | undefined;
  demo?: boolean;
  jurisdiction?: string | undefined;
  jurisdictionNote?: string | undefined;
  headingLevel?: 2 | 3 | 4;
  surface?: "white" | "alabaster" | "slate";
  /** Gallery only: show the hover or focus state (V1-49), like the form controls' .is-hover/.is-focus. */
  state?: "hover" | "focus" | undefined;
}
const {
  title,
  href,
  coverId,
  pillar,
  summary,
  format,
  level,
  date,
  demo = false,
  jurisdiction,
  jurisdictionNote,
  headingLevel = 2,
  surface = "white",
  state,
} = Astro.props;
const place = jurisdictionLabel(jurisdiction, jurisdictionNote);
const Heading = `h${headingLevel}` as "h2" | "h3" | "h4";
---

<article class={`story-card surface-${surface}${state ? ` is-${state}` : ""}`} data-testid="story-card">
  <StoryCover id={coverId} pillar={pillar} />
  <Heading class="story-card-title">
    <a href={href}>{title}</a>
  </Heading>
  <p class="story-card-summary">{summary}</p>
  <dl class="story-card-meta">
    <div>
      <dt>Format</dt>
      <dd>{labelOf(format)}</dd>
    </div>
    <div>
      <dt>Level</dt>
      <dd>{labelOf(level)}</dd>
    </div>
    {date && (
      <div>
        <dt>Published</dt>
        <dd>
          <time datetime={isoDate(date)}>{formatDateGB(date)}</time>
        </dd>
      </div>
    )}
  </dl>
  {place && (
    <p class="story-card-jurisdiction" data-testid="jurisdiction-label">
      {place}
    </p>
  )}
  {demo && <p class="story-card-demo">Demo content</p>}
</article>
