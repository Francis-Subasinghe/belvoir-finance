---
/** F2-27 button. Always a <button> with an explicit type. Surfaces: white, alabaster. */
interface Props {
  type: "button" | "submit" | "reset";
  variant?: "primary" | "secondary";
  disabled?: boolean;
  demoState?: "hover" | "focus";
  id?: string;
  /** F4: a hook for the explorer script (data-action). */
  action?: string;
}
const { type, variant = "primary", disabled = false, demoState, id, action } = Astro.props;
---

<button
  id={id}
  data-action={action}
  type={type}
  class:list={["button", `button-${variant}`, { [`is-${demoState}`]: demoState }]}
  disabled={disabled}
>
  <slot />
</button>
